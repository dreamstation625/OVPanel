# Local design documents
/docs/

# Go build and profiling output
/bin/
/build/
/dist/
*.exe
*.test
*.prof
coverage*.out

# Vue / Node dependencies and build output
**/node_modules/
**/dist/
**/.vite/
**/coverage/
*.tsbuildinfo

# Keep the embed placeholder so //go:embed all:dist compiles before a web build.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx

# Persistent runtime data, backups, and temporary output
/data/
/certs/
/runtime/
/backups/
/logs/
/tmp/
/cache/
/deploy/data/
/deploy/runtime/
/deploy/backups/
/deploy/certs/
*.log
*.tmp

# Editors and operating systems
.idea/
.vscode/
.vs/
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
