# 复制为 deploy/.env 后按需修改。该文件会被 Compose 自动读取。
# 不要提交真实口令、私钥或证书。

# 本地构建的镜像名；发布时改为带版本与 digest 的完整引用。
OVPANEL_VERSION=dev
OVPANEL_COMMIT=none
OVPANEL_BUILD_TIME=unknown
OVPANEL_PANEL_IMAGE=ovpanel-panel:dev
OVPANEL_OPENVPN_IMAGE=ovpanel-openvpn:dev

# 管理端绑定。默认只允许本机访问。
# 公网或局域网访问前：配置 HTTPS，并把绑定改为 0.0.0.0。
OVPANEL_ADMIN_BIND=127.0.0.1
OVPANEL_ADMIN_PORT=8080

# 宿主持久化目录与证书目录，相对于 deploy/ 解析。
OVPANEL_DATA_ROOT=./data
OVPANEL_CERT_DIR=./certs

OVPANEL_LOG_LEVEL=info
OVPANEL_SESSION_TTL=12h

# 直接由 Go 进程提供 HTTPS 时，填写容器内证书路径，例如：
#   OVPANEL_TLS_CERT=/certs/panel.crt
#   OVPANEL_TLS_KEY=/certs/panel.key
OVPANEL_TLS_CERT=
OVPANEL_TLS_KEY=

# 仅本机调试使用：生成内存中的短期自签名证书。生产必须为 false。
OVPANEL_DEV_SELF_SIGNED=false

# 可选的一次性初始化口令（至少 16 个字符）。
# 留空时面板会生成到数据目录的 bootstrap-token，初始化成功后自动删除。
OVPANEL_BOOTSTRAP_TOKEN=

# 可选的主密钥（32 字节，base64 或 hex）。
# 留空时首次启动生成到数据目录的 master.key（容器内 /data/master.key）。
# 该密钥用于解密 CA/客户端私钥与 tls-crypt；备份和迁移必须一并保存。
OVPANEL_MASTER_KEY=
