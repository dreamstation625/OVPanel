# OVPanel OpenVPN 容器镜像。
#
# P02 镜像只包含运行代理骨架与数据面工具，不启动 OpenVPN；
# 配置、PKI、准入与网络规则在后续阶段接入。
#
# 基础镜像使用 P00 固定的 alpine:edge digest（OpenVPN 2.7.7），
# 同一 digest 同时覆盖 amd64 与 arm64。
#
# Go 构建固定在 BUILDPLATFORM 上原生执行，按 TARGETARCH 交叉编译；
# 只有运行阶段的 apk 安装会落到目标架构。

ARG GO_IMAGE=golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build

WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_TIME=unknown
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -trimpath -buildvcs=false \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildTime=${BUILD_TIME}" \
      -o /out/vpn-agent ./cmd/vpn-agent

ARG RUNTIME_IMAGE=alpine@sha256:020dfcbaaf4cc1078bf2d9c7ba31a8466e334061dcd2f248001d68f79e52c000
FROM ${RUNTIME_IMAGE}

RUN apk add --no-cache \
      openvpn \
      nftables \
      iproute2 \
      iputils \
      ca-certificates \
      tzdata \
 && test "$(openvpn --version | awk 'NR==1 {print $2}')" = "2.7.7" \
 && mkdir -p /var/lib/ovpanel /etc/openvpn/ovpanel \
 && chmod 0700 /var/lib/ovpanel

COPY --from=build /out/vpn-agent /usr/local/bin/vpn-agent

LABEL org.opencontainers.image.title="OVPanel OpenVPN runtime" \
      org.opencontainers.image.description="OVPanel OpenVPN container with runtime agent" \
      org.opencontainers.image.source="https://github.com/dreamstation625/OVPanel"

ENV OVPANEL_AGENT_LISTEN=:9443 \
    OVPANEL_AGENT_STATE_DIR=/var/lib/ovpanel

EXPOSE 9443/tcp 1194/udp

ENTRYPOINT ["/usr/local/bin/vpn-agent"]
