# 复制为项目根目录的 .env 后按需修改，Compose 会自动读取。
# 不要提交真实口令、私钥或证书。

# 默认使用 Docker Hub 上的发布镜像；本地构建会以同名标签覆盖。
OVPANEL_VERSION=0.0.8
OVPANEL_COMMIT=none
OVPANEL_BUILD_TIME=unknown
OVPANEL_PANEL_IMAGE=dreamstation625/ovpanel:latest
OVPANEL_OPENVPN_IMAGE=dreamstation625/ovpanel-openvpn:latest
# 网页 OpenVPN 更新只允许该仓库下的合法标签。
OVPANEL_OPENVPN_REPOSITORY=dreamstation625/ovpanel-openvpn

# 管理端绑定。默认只允许本机访问。
# 公网或局域网访问前：配置 HTTPS，并把绑定改为 0.0.0.0。
OVPANEL_ADMIN_BIND=127.0.0.1
OVPANEL_ADMIN_PORT=8080

# OpenVPN 数据面端口。必须与面板「服务端」页保存的协议/端口一致，
# 否则容器没有发布客户端要连的端口。修改后需重建 openvpn 容器。
OVPANEL_VPN_BIND=0.0.0.0
OVPANEL_VPN_PORT=1194
OVPANEL_VPN_PROTO=udp

# 面板所在的 Docker bridge 子网，不能与 VPN 网段、目标网段、
# 客户端共享内网或宿主局域网重叠。修改后需删除并重建 ovpanel 网络。
OVPANEL_DOCKER_SUBNET=10.250.0.0/24

# 宿主持久化目录与证书目录，相对于项目根目录（compose.yaml 所在目录）解析。
OVPANEL_DATA_ROOT=./data
OVPANEL_CERT_DIR=./certs

OVPANEL_LOG_LEVEL=info
OVPANEL_SESSION_TTL=12h

# 直接由 Go 进程提供 HTTPS 时，填写容器内证书路径，例如：
#   OVPANEL_TLS_CERT=/certs/panel.crt
#   OVPANEL_TLS_KEY=/certs/panel.key
OVPANEL_TLS_CERT=
OVPANEL_TLS_KEY=

# 仅本机调试使用：生成内存中的短期自签名证书。生产必须为 false。
OVPANEL_DEV_SELF_SIGNED=false

# 可选的一次性初始化口令（至少 16 个字符）。
# 留空时面板会生成到数据目录的 bootstrap-token，初始化成功后自动删除。
OVPANEL_BOOTSTRAP_TOKEN=

# 可选的主密钥（32 字节，base64 或 hex）。
# 留空时首次启动生成到数据目录的 master.key（容器内 /data/master.key）。
# 该密钥用于解密 CA/客户端私钥与 tls-crypt；备份和迁移必须一并保存。
OVPANEL_MASTER_KEY=
