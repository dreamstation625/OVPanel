# compose.host.yaml 专用环境变量示例。
# 首次使用时复制为编排目录下的 .env；已有 .env 时合并所需参数。
# 宝塔、1Panel 也可在编排的环境变量配置中填写这些参数。
# 不要提交真实口令、私钥或证书。

# 两个镜像使用相同的发布标签。默认 latest，跟随 main 的最新正式版。
# 生产环境建议固定为 0.0.4 或更新的正式版本。
OVPANEL_PANEL_IMAGE=dreamstation625/ovpanel:latest
OVPANEL_OPENVPN_IMAGE=dreamstation625/ovpanel-openvpn:latest
OVPANEL_OPENVPN_REPOSITORY=dreamstation625/ovpanel-openvpn

# 管理端默认仅本机可访问。公网或局域网访问前先配置 HTTPS，再调整绑定。
OVPANEL_ADMIN_BIND=127.0.0.1
OVPANEL_ADMIN_PORT=8080

# host 模式直接使用宿主端口；端口和协议须与面板「服务端」配置一致。
# 修改后重新部署 OpenVPN，并同步宿主防火墙、云安全组及客户端连接地址。
OVPANEL_VPN_PORT=1194
OVPANEL_VPN_PROTO=udp

# 使用宿主绝对路径，避免受宝塔、1Panel 编排工作目录影响。
OVPANEL_DATA_ROOT=/opt/ovpanel/data
OVPANEL_CERT_DIR=/opt/ovpanel/certs

OVPANEL_LOG_LEVEL=info
OVPANEL_SESSION_TTL=12h

# 将证书放入 OVPANEL_CERT_DIR，以下填写容器内路径以开启 HTTPS。
# OVPANEL_TLS_CERT=/certs/panel.crt
# OVPANEL_TLS_KEY=/certs/panel.key
OVPANEL_TLS_CERT=
OVPANEL_TLS_KEY=

# 仅本机调试使用短期自签名证书，生产保持 false。
OVPANEL_DEV_SELF_SIGNED=false

# 可选的一次性初始化口令（至少 16 字符）；留空自动生成。
# 自动生成位置：OVPANEL_DATA_ROOT/panel/bootstrap-token，初始化后删除。
OVPANEL_BOOTSTRAP_TOKEN=

# 可选主密钥（32 字节，base64 或 hex）；留空自动生成。
# 自动生成位置：OVPANEL_DATA_ROOT/panel/master.key，备份和迁移须保留。
OVPANEL_MASTER_KEY=
